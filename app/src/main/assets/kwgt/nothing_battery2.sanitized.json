                  {
                    "internal_type": "ShapeModule",
                    "internal_title": "Border",
                    "internal_toggles": {
                      "shape_width": 0,
                      "paint_color": 100
                    },
                    "internal_formulas": {
                      "shape_width": "$gv(side)/1.42$"
                    },
                    "shape_type": "RECT",
                    "shape_height": 78.0,
                    "shape_corners": 14.0,
                    "paint_style": "STROKE",
                    "paint_stroke": 3.5,
                    "shape_width": 195.0,
                    "internal_globals": {
                      "paint_color": "fg"
                    }
                  },
                  {
                    "internal_type": "ShapeModule",
                    "internal_toggles": {
                      "shape_width": 0
                    },
                    "internal_formulas": {
                      "shape_width": "$gv(side)/1.53$"
                    },
                    "shape_type": "RECT",
                    "shape_height": 64.0,
                    "shape_corners": 7.0,
                    "internal_title": "Clip",
                    "fx_mask": "CLIP_NEXT",
                    "shape_width": 179.0
                  },
                  {
                    "internal_type": "ProgressModule",
                    "internal_toggles": {
                      "style_size": 0,
                      "progress_level": 10,
                      "progress_rotate_mode": 10,
                      "color_fgcolor": 100,
                      "color_bgcolor": 100
                    },
                    "internal_formulas": {
                      "style_size": "$gv(side)/1.5$",
                      "progress_level": "$bi(level)$"
                    },
                    "progress_progress": "CUSTOM",
                    "progress_mode": "SHAPES",
                    "progress_count": 16.0,
                    "style_size": 184.0,
                    "style_shape": "RECT",
                    "style_width": 60.0,
                    "style_height": 64.0,
                    "internal_globals": {
                      "color_fgcolor": "fg",
                      "color_bgcolor": "accent"
                    }
                  }
                ]
              },
              {
                "internal_type": "ShapeModule",
                "shape_type": "RECT",
                "shape_width": 5.0,
                "shape_height": 28.0,
                "shape_corners": 360,
                "internal_toggles": {
                  "paint_color": 100
                },
                "internal_globals": {
                  "paint_color": "fg"
                }
              }
            ]
          },
          {
            "internal_type": "StackLayerModule",
            "config_stacking": "HORIZONTAL_BOTTOM",
            "viewgroup_items": [
              {
                "internal_type": "TextModule",
                "text_expression": "$bi(level)$",
                "text_size": 32.0,
                "internal_toggles": {
                  "paint_color": 100,
                  "text_size": 10
                },
                "internal_globals": {
                  "paint_color": "fg"
                },
                "internal_formulas": {
                  "text_size": "$gv(side)/4.5$"
                }
              },
              {
                "internal_type": "TextModule",
                "text_expression": "%",
                "text_size": 32.0,
                "internal_toggles": {
                  "paint_color": 100,
                  "text_size": 10
                },
                "internal_globals": {
                  "paint_color": "fg"
                },
                "internal_formulas": {
                  "text_size": "$gv(side)/10$"
                }
              }
            ]
          },
          {
            "internal_type": "StackLayerModule",
            "config_stacking": "HORIZONTAL_BOTTOM",
            "config_margin": 8.0,
            "viewgroup_items": [
              {
                "internal_type": "TextModule",
                "text_expression": "$tf(bi(fullempty), h)$H$tf(bi(fullempty), m)$M",
                "text_size": 32.0,
                "internal_toggles": {
                  "paint_color": 100,
                  "text_size": 10
                },
                "internal_globals": {
                  "paint_color": "fg"
                },
                "internal_formulas": {
                  "text_size": "$gv(side)/15$"
                },
                "note": "native Android uses only BatteryManager.computeChargeTimeRemaining while charging; otherwise -- is shown"
              },
              {
                "internal_type": "TextModule",
                "text_expression": "REMAINING",
                "text_size": 32.0,
                "internal_toggles": {
                  "paint_color": 100,
                  "text_size": 10
                },
                "internal_globals": {
                  "paint_color": "primary"
                },
                "internal_formulas": {
                  "text_size": "$gv(side)/15$"
                },
                "paint_color": "#FFD71921"
              }
            ]
          }
        ]
      }
    ]
  }
