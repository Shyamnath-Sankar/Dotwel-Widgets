<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/widget_ink"
            android:textSize="28sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.18"
            android:text="@string/style_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/style_black"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/dot_accent"
                android:minHeight="48dp"
                android:text="@string/style_black"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/style_translucent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/dot_accent"
                android:minHeight="48dp"
                android:text="@string/style_translucent"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/style_transparent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/dot_accent"
                android:minHeight="48dp"
                android:text="@string/style_transparent"
                android:textColor="@color/widget_ink"
                android:textSize="14sp" />

        </RadioGroup>

        <LinearLayout
            android:id="@+id/clock_setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_setup_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/clock_setup_title"
                android:textColor="@color/widget_ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/clock_setup_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/exact_alarm_status_disabled_short"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/exact_alarm_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/dot_accent"
                android:minHeight="48dp"
                android:text="@string/exact_alarm_enable"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.18"
            android:text="@string/gallery_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/gallery_note"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/gallery_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/refresh_widgets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/dot_accent"
            android:minHeight="48dp"
            android:text="@string/refresh_widgets"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/settings_hint"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/attribution_short"
            android:textColor="@color/settings_faint"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
