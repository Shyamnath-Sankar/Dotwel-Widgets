<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:letterSpacing="0.02"
            android:text="@string/app_name"
            android:textColor="@color/widget_ink"
            android:textSize="30sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/settings_subtitle"
            android:textColor="@color/widget_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.18"
            android:text="@string/preview_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/preview_card_clock"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_widget_black"
            android:padding="12dp">

            <ImageView
                android:id="@+id/preview_clock"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/clock_preview_description"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/preview_card_date"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_widget_black"
            android:padding="12dp">

            <ImageView
                android:id="@+id/preview_date"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/date_preview_description"
                android:scaleType="fitCenter" />

        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/preview_note"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.18"
            android:text="@string/exact_alarm_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/exact_alarm_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/exact_alarm_status_disabled"
            android:textColor="@color/widget_ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/exact_alarm_button"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/dot_accent"
            android:text="@string/exact_alarm_enable"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/exact_alarm_explainer"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.18"
            android:text="@string/style_label"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />

        <RadioGroup
            android:id="@+id/style_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/style_black"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="@color/dot_accent"
                android:text="@string/style_black"
                android:textColor="@color/widget_ink"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/style_translucent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="@color/dot_accent"
                android:text="@string/style_translucent"
                android:textColor="@color/widget_ink"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/style_transparent"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="@color/dot_accent"
                android:text="@string/style_transparent"
                android:textColor="@color/widget_ink"
                android:textSize="16sp" />

        </RadioGroup>

        <Button
            android:id="@+id/refresh_widgets"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/dot_accent"
            android:text="@string/refresh_widgets"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/settings_hint"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/attribution_short"
            android:textColor="@color/settings_faint"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>
