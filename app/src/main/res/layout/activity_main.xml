<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="108dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="16dp"
            android:paddingEnd="18dp"
            android:paddingBottom="16dp">

            <com.dotwelwidgets.dotwellabs.DotHeadingView
                android:id="@+id/heading_dots"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="1dp"
                android:text="@string/settings_subtitle"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/clock_setup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_setup_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="6dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/clock_setup_title"
                        android:textColor="@color/widget_ink"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/clock_setup_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/exact_alarm_status_disabled_short"
                        android:textColor="@color/widget_muted"
                        android:textSize="11sp" />

                </LinearLayout>

                <Button
                    android:id="@+id/exact_alarm_button"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:backgroundTint="@color/dot_accent"
                    android:minWidth="88dp"
                    android:text="@string/exact_alarm_enable_short"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />

            </LinearLayout>

            <Button
                android:id="@+id/weather_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1B1E24"
                android:minHeight="48dp"
                android:text="@string/weather_header_off"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/gallery_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:letterSpacing="0.16"
                android:text="@string/home_categories_label"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/gallery_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <Button
                android:id="@+id/upcoming_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:backgroundTint="#1B1E24"
                android:gravity="start|center_vertical"
                android:minHeight="48dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/upcoming_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <Button
                android:id="@+id/refresh_widgets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1B1E24"
                android:minHeight="48dp"
                android:text="@string/refresh_widgets"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="@string/settings_hint"
                android:textColor="@color/widget_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/about_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#1B1E24"
                android:minHeight="48dp"
                android:text="@string/about_button"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="5dp">

        <TextView
            android:id="@+id/nav_widgets"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/nav_widgets"
            android:textColor="@color/dot_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nav_style"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/nav_style"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nav_about"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:text="@string/nav_about"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
