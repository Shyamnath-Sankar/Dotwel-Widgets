<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_gallery_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:textColor="@color/widget_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/card_status_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/widget_ink"
            android:textSize="11sp" />

    </LinearLayout>

    <FrameLayout
        android:id="@+id/card_preview_frame"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_black"
        android:padding="10dp">

        <ImageView
            android:id="@+id/card_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/gallery_preview_description"
            android:scaleType="fitCenter" />

        <TextClock
            android:id="@+id/card_preview_clock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoSizeMaxTextSize="64sp"
            android:autoSizeMinTextSize="22sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="monospace"
            android:format12Hour="@string/clock_format_12"
            android:format24Hour="@string/clock_format_24"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:lineSpacingMultiplier="0.9"
            android:maxLines="2"
            android:textColor="@color/widget_ink"
            android:textSize="52sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <AnalogClock
            android:id="@+id/card_preview_analog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/analog_preview_description"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/card_preview_world"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/card_world_label_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextClock
                android:id="@+id/card_world_clock_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-condensed"
                android:format12Hour="@string/world_time_format_12"
                android:format24Hour="@string/world_time_format_24"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/card_world_label_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextClock
                android:id="@+id/card_world_clock_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="28sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="sans-serif-condensed"
                android:format12Hour="@string/world_time_format_12"
                android:format24Hour="@string/world_time_format_24"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/widget_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/card_preview_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_chip"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="@string/preview_badge"
            android:textColor="@color/widget_ink"
            android:textSize="10sp" />

    </FrameLayout>

    <Button
        android:id="@+id/card_add"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/dot_accent"
        android:minHeight="48dp"
        android:textColor="@android:color/white"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/card_status_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <Button
        android:id="@+id/card_secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="#1B1E24"
        android:minHeight="48dp"
        android:textColor="@color/widget_ink"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
