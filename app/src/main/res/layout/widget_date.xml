<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_black"
    android:padding="10dp">

    <TextClock
        android:id="@+id/date_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:autoSizeMaxTextSize="104sp"
        android:autoSizeMinTextSize="32sp"
        android:autoSizeStepGranularity="2sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="serif"
        android:format12Hour="d"
        android:format24Hour="d"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:padding="0dp"
        android:textColor="@color/widget_ink"
        android:textSize="84sp" />

    <TextClock
        android:id="@+id/date_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:fontFamily="serif"
        android:format12Hour="EEE"
        android:format24Hour="EEE"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:padding="0dp"
        android:textColor="@color/dot_accent"
        android:textSize="18sp" />

</FrameLayout>
